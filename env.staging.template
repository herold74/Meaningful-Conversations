# Staging environment template — copy to .env.staging and fill in secrets.
# DO NOT commit .env.staging!
# Full reference: meaningful-conversations-backend/.env.example + podman-compose-staging.yml

# Container Registry (GitLab) — see DOCUMENTATION/GITLAB-REGISTRY-SETUP.md
REGISTRY_URL=regy.rhepds.com
REGISTRY_LOGIN_USER=<YOUR_REGISTRY_USER>
REGISTRY_IMAGE_PREFIX=gherold/meaningful-conversations
REGISTRY_PASSWORD=

# Database (MariaDB pod)
DB_USER=mcuser
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=meaningful_conversations_staging

# Application
ENVIRONMENT_TYPE=staging
FRONTEND_URL=https://mc-beta.manualmode.at
JWT_SECRET=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Email (Mailjet)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Apple IAP
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=at.manualmode.mc
APPLE_IAP_ENVIRONMENT=sandbox

# TTS (Piper — use -c all deploy when tts-service/ changes)
TTS_ENABLED=true
TTS_SERVICE_URL=http://tts:8082
