# Copy to server only: /root/.mc-ops-report.env (not in git)
MC_OPS_REPORT_EMAIL=support@manualmode.at
# Optional explicit From header (should match Mailjet verified sender / msmtprc `from`):
# MC_OPS_REPORT_FROM=register@manualmode.at
#
# Outbound relay: msmtp → Mailjet SMTP (same credentials as the app).
# Server: /etc/msmtprc account `default`, host in-v3.mailjet.com:587.
# Values from /opt/manualmode-production/.env: MAILJET_API_KEY, MAILJET_SECRET_KEY, MAILJET_SENDER_EMAIL.
# See scripts/MONITORING-QUICK-REFERENCE.md § Server-Ops E-Mail-Report.
