[Unit]
Description=MC Podman stack watchdog (prod + staging)
After=network-online.target

[Service]
Type=oneshot
# Backend recreate + nginx IP update can exceed default 90s (Oct 2026 incident: repair killed by timeout).
TimeoutStartSec=900
TimeoutStopSec=120
ExecStart=/usr/local/bin/mc-stack-watchdog.sh

[Install]
WantedBy=multi-user.target
