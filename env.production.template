# Production environment template — copy to .env.production and fill in secrets.
# DO NOT commit .env.production!
# Production pulls staging-built images — see deployment skill.

# Container Registry (GitLab)
REGISTRY_URL=regy.rhepds.com
REGISTRY_LOGIN_USER=<YOUR_REGISTRY_USER>
REGISTRY_IMAGE_PREFIX=gherold/meaningful-conversations
REGISTRY_PASSWORD=

# Database (MariaDB pod — use strong passwords, no defaults in production)
DB_USER=mcuser
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=meaningful_conversations_production

# Application
ENVIRONMENT_TYPE=production
FRONTEND_URL=https://mc-app.manualmode.at
JWT_SECRET=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Email (Mailjet)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=

# PayPal (required: PAYPAL_WEBHOOK_ID for webhook signature verification)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# Apple IAP (APPLE_APP_ID required when APPLE_IAP_ENVIRONMENT=production)
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=at.manualmode.mc
APPLE_IAP_ENVIRONMENT=production
APPLE_APP_ID=

# RevenueCat (optional sync)
# REVENUECAT_SECRET_KEY=

# TTS
TTS_ENABLED=true
TTS_SERVICE_URL=http://tts:8082

# Admin seed (first deploy only)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
