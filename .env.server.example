# Server Configuration (copy to .env.server and fill in your values)
# This file is committed as a template. .env.server is gitignored.
#
# deploy-manualmode.sh requires this file on disk — SERVER_HOST from the
# environment alone (e.g. Cursor Cloud Secrets) is not accepted.

# The IP or hostname of your deployment server (or 127.0.0.1 if you SSH via local tunnel)
SERVER_HOST=your.server.ip.here
